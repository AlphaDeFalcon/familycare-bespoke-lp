# Copy this file to .env.local for local development.
#
# Vite inlines these values at build time. Rebuild the site after changing
# either value.

# Endpoint that receives enquiry-form submissions as POST JSON.
# Absolute URL (https://crm.example.com/leads) or same-origin path (/api/leads).
# Leave blank to accept submissions in the browser without delivering them.
# See docs/crm-integration.md for the payload contract and setup guide.
VITE_LEAD_ENDPOINT=""

# Optional Google Tag Manager container ID (for example GTM-ABC1234).
# Leave blank to skip loading GTM.
VITE_GTM_ID=""
